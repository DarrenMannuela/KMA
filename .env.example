# Copy to .env and fill in. .env is git-ignored: never commit it (this
# repository is public).

# Same value as AUTH_INTERNAL_KEY in KMA-Auth's .env: the shared secret
# this backend sends when it asks the auth service whether a session is
# valid. Generate with: openssl rand -hex 32
AUTH_INTERNAL_KEY=
# Where the auth service is, inside kma_network. The default is right for
# Docker; only change it when running the backend outside Docker.
AUTH_SERVICE_URL=http://kma_auth_backend:8001

# A second place every backup is copied to, off this disk if you can: an
# external drive or a synced folder (iCloud Drive, Google Drive), e.g.
#   BACKUP_COPY_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/KMA backups
# The folder must exist. Leave empty for no copy.
BACKUP_COPY_DIR=
